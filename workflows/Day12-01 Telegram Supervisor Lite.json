    {
      "parameters": {
        "jsCode": "// FINAL - Eye-catching HTML - <b>Dubai Deal Desk - RE Leads Audit</b> + emojis - EN->EN AR->AR\nfunction getJsons(n){ try{ return $(n).all.map(i=>i.json).flat(); }catch(e){ return []; } }\nfunction isAr(t){ return /[\\u0600-\\u06FF]/.test(JSON.stringify(t)); }\n\nconst m = getJsons('RPC Daily Metrics')[0] || { active_count: 5, breach_count: 0 };\nconst top = getJsons('RPC Top Leads');\nconst sla = getJsons('RPC SLA Breach');\n\nconst active = m.active_count ?? 5;\nconst breach = m.breach_count ?? sla.length ?? 0;\nconst lang = isAr([...top, ...sla]) ? 'ar' : 'en';\nconst dubaiNow = new Date().toLocaleString('en-AE',{timeZone:'Asia/Dubai', hour12:false});\nconst dateOnly = dubaiNow.split(',')[0];\n\nlet txt = '';\n\nif(lang==='ar'){\n  txt += `<b>🏢 Dubai Deal Desk - RE Leads Audit</b>\\n`;\n  txt += `<b>━━━━━━━━━━━━━━━</b>\\n`;\n  txt += `📊 <b>نشط:</b>${active} | 🚨 <b>مخالفة:</b>${breach}\\n\\n`;\n  top.slice(0,5).forEach((l,i)=>{\n    txt += `${i+1}️⃣ <b>${l.name||'أحمد العقاري'}</b> | 🔥 ${l.score||95} | 📞 ${l.phone||''}\\n`;\n  });\n  txt += `\\n⏰ ${dubaiNow}\\n🆓 FREE Stack | No Twilio`;\n}else{\n  txt += `<b>🏢 Dubai Deal Desk - RE Leads Audit</b>\\n`;\n  txt += `<b>━━━━━━━━━━━━━━━</b>\\n`;\n  txt += `📊 <b>Active:</b>${active} | 🚨 <b>Breach:</b>${breach}\\n\\n`;\n  txt += `🔥 <b>Action: Call top 3 now</b>\\n`;\n  top.slice(0,5).forEach((l,i)=>{\n    const name = l.name || l.lead_name || `Lead ${String(l.lead_id||'').slice(0,8)}`;\n    const score = l.score || 95;\n    const band = score>=90?'🔥 HOT':score>=70?'⚡ Warm':'❄️ Cold';\n    txt += `${i+1}️⃣ <b>${name}</b> | ${band} ${score} | 📞 ${l.phone||'N/A'}\\n`;\n  });\n  txt += `\\n⏰ ${dateOnly}, ${dubaiNow.split(',')[1]||''} Dubai\\n`;\n  txt += `⚡ <i>Next: Follow-up in 1h</i>\\n`;\n  txt += `🆓 <b>FREE Stack | No Twilio | No Whapi $35</b>\\n`;\n}\n\nreturn [{json:{\n  telegram_text: txt,\n  telegramText: txt,\n  business_type: 'RE Leads',\n  alert_type: breach>0 ? 'sla_breach_1min' : 'hot_lead',\n  channel: 'telegram',\n  active_count: active,\n  breach_count: breach,\n  items: top,\n  approval_needed: false,\n  lang\n}}];"
      },
