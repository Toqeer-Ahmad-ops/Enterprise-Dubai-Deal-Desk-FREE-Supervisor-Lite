    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst err = e.error || {};\nconst exec = e.execution || {};\nconst wf = e.workflow || {};\n\n// Only take short description, not full JSON\nlet msg = err.description || err.message || '';\nif (typeof msg !== 'string') msg = '';\n// If still empty, search for short phrase\nif (!msg) {\n  const full = JSON.stringify(e);\n  const m = full.match(/Could not find[^.\"]+/i) || full.match(/Failed[^.\"]+/i);\n  msg = m ? m[0] : 'Workflow failed at ' + (err.lastNodeExecuted || 'Check Duplicate');\n}\n\nconst dubai = new Date().toLocaleString('en-GB',{timeZone:'Asia/Dubai',hour12:false});\n\nreturn [{\n  json: {\n    workflow_name: wf.name || e.workflow_name || 'Day12-01 Telegram Supervisor Lite',\n    workflow_id: wf.id || e.workflow_id || '',\n    execution_id: exec.id || e.execution_id || '',\n    execution_url: exec.url || e.execution_url || '',\n    node_name: e.node?.name || e.node_name || err.lastNodeExecuted || 'Check Duplicate',\n    error_message: msg.slice(0,200),\n    severity: 'critical',\n    business_type: 'RE Leads',\n    dubai_time: dubai\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        -80
      ],
      "id": "b07de49e-d0ff-4793-83d5-2dabec0eb089",
      "name": "Set Error Context"
    },
