    {
      "parameters": {
        "jsCode": "const a = $('Get Overdue Expenses').first().json;\nconst b = $('Get Overdue Expenses').last().json;\nlet items = [a];\nif (b && b.id !== a.id) items.push(b);\n\nconst dashLink = \"https://supabase.com/dashboard/project/pnafbhfijmaaxsertzof\";\nconst now = new Date().toLocaleString('en-GB', {timeZone: 'Asia/Dubai', hour12:false});\nconst nums = [\"1️⃣\",\"2️⃣\",\"3️⃣\"];\n\nlet text = \"<b>💰 Finance Desk - Approval Needed</b>\\n\";\ntext += \"<b>━━━━━━━━━━━━━━━</b>\\n\";\ntext += \"Overdue: \" + items.length + \" | ⚠️ Action: Approval\\n\";\nfor (let i=0;i<items.length;i++){\n  let e = items[i];\n  let expId = e.entity_id || e.expense_id || e.id;\n  let vendor = (e.vendor && !e.vendor.includes(\"AED\")) ? e.vendor : \"Generic Supplier\";\n  let expLink = \"<a href=\\\"\" + dashLink + \"\\\">\" + expId + \"</a>\";\n  text += nums[i] + \" \" + expLink + \" | AED \" + e.amount + \" | Vendor: \" + vendor + \" | Conf \" + Math.round((e.confidence||0.82)*100) + \"%\\n\";\n  text += \"   Status: \" + e.status + \" | <a href=\\\"\" + dashLink + \"\\\">✅ Approve</a> | <a href=\\\"\" + dashLink + \"\\\">❌ Reject</a>\\n\";\n}\ntext += \"\\n⏰ \" + now + \"\\n\";\ntext += \"<a href=\\\"\" + dashLink + \"\\\">📊 View Dashboard</a> | <a href=\\\"https://rematch-extent-geology.ngrok-free.dev\\\">⚙️ View n8n</a>\\n\";\ntext += \"🆓 FREE Stack | Telegram API\";\n\nreturn [{json:{\n  telegram_text: text,\n  telegramText: text,\n  business_type: 'Finance Approval',\n  entity_type: 'expense',\n  alert_type: 'finance_expense_approval',\n  channel: 'telegram',\n  requires_approval: true,\n  items: items\n}}];"
      },
