    {
      "parameters": {
        "jsCode": "const a = $('Get Order Items').first().json;\nconst b = $('Get Order Items').last().json;\nlet items = [a];\nif (b && b.id !== a.id) items.push(b);\n\nlet total = 0;\nfor (let i=0;i<items.length;i++) total += Number(items[i].amount) || 0;\n\nfunction getDetail(e){\n  if (e.exception_type === 'payment_failed') return {action: 'Retry payment + Call customer', owner: 'Finance Ops', impact: 'Order blocked'};\n  if (e.exception_type === 'stock_short') return {action: 'Check warehouse + Reorder', owner: 'Warehouse', impact: 'Fulfillment delayed'};\n  return {action: 'Review + Escalate', owner: 'Ops Team', impact: 'Needs review'};\n}\n\nconst dashLink = \"https://supabase.com/dashboard/project/pnafbhfijmaaxsertzof\";\nconst now = new Date().toLocaleString('en-GB', {timeZone: 'Asia/Dubai', hour12:false});\nconst nums = [\"1️⃣\",\"2️⃣\",\"3️⃣\"];\n\nlet text = \"<b>📦 Order Processing - \" + items.length + \" exceptions | At Risk AED \" + total + \"</b>\\n\";\ntext += \"<b>━━━━━━━━━━━━━━━</b>\\n\";\nfor (let i=0;i<items.length;i++){\n  let e = items[i];\n  let d = getDetail(e);\n  let orderLink = \"<a href=\\\"\" + dashLink + \"\\\">\" + e.order_id + \"</a>\";\n  text += nums[i] + \" \" + orderLink + \" | \" + e.exception_type + \" | AED \" + e.amount + \"\\n\";\n  text += \"   Impact: \" + d.impact + \"\\n\";\n  text += \"   Action: \" + d.action + \" | Owner: \" + d.owner + \"\\n\";\n  text += \"   <a href=\\\"\" + dashLink + \"\\\">✅ Resolve</a> | <a href=\\\"\" + dashLink + \"\\\">❌ Escalate</a>\\n\";\n}\ntext += \"\\n⏰ SLA: Resolve in 2h | Turnaround 24h->2h\\n\";\ntext += \"⏰ \" + now + \"\\n\";\ntext += \"<a href=\\\"\" + dashLink + \"\\\">📊 View Dashboard</a> | <a href=\\\"https://rematch-extent-geology.ngrok-free.dev\\\">⚙️ View n8n</a>\\n\";\ntext += \"🆓 FREE Stack | Telegram API\";\n\nreturn [{json:{\n  telegram_text: text,\n  telegramText: text,\n  business_type: 'Order Processing',\n  entity_type: 'order',\n  alert_type: 'order_exception',\n  channel: 'telegram',\n  requires_approval: true,\n  items: items\n}}];"
      },
