# ============================================================
# Dubai Deal Desk — Day 12 — .env.example
# Copy to .env and fill YOUR values. NEVER commit real .env
# NEVER push keys starting with eyJ, bot, xox, sk-, or ngrok URLs
# ============================================================

# --- Supabase — Day 12 ---
# Project: Retail-SOP (product name: Dubai Deal Desk)
# Get from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=YOUR_SUPABASE_URL
# Example format (DO NOT paste real): https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Use ANON for frontend / n8n reads. Use SERVICE_ROLE only in n8n server (never in browser).

# --- Supabase Tables — Day 12 (already created via sql/01-day12-supabase-schema.sql) ---
# v_deployments_dashboard (view)
# notification_log, approval_queue, sla_alert_log
# finance_expenses_sim (SIMULATED), ecom_orders_sim (SIMULATED)

# --- Telegram — Day 12 Supervisor Lite + Finance + Order + Error Admin ---
# Create bot via @BotFather on Telegram, then get token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Chat ID for Deal Desk alerts (your group / channel / DM)
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# Chat ID for Error Admin alerts (Day12-00) — can be same or separate
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_ADMIN_CHAT_ID
# Telegram Bot Username (without @) — for README links only
TELEGRAM_BOT_USERNAME=YOUR_TELEGRAM_BOT_USERNAME

# --- n8n — Day 12 ---
# Your n8n base URL (self-hosted Docker). No ngrok in production.
N8N_BASE_URL=YOUR_N8N_BASE_URL
# Example: http://localhost:5678 or https://n8n.YOUR_DOMAIN.com
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL
# Error Workflow: Day12-00 Error Trigger Admin
# Set in n8n: Workflow Settings > Error Workflow > Day12-00

# --- Cron — Dubai Time (Asia/Dubai) ---
# Day12-01 RE: 10 5 * * *  = 09:10 Dubai
# Day12-02 Finance: 15 5 * * * = 09:15 Dubai
# Day12-03 Order: 20 5 * * * = 09:20 Dubai
TIMEZONE=Asia/Dubai

# --- Gemini — Optional (Day 11 Scoring / Day 13+ Agents) ---
# Leave empty if not using Gemini in Day 12. Day 12 is rule-based, no LLM needed.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- WhatsApp Cloud API — Day 13 (FUTURE, commented) ---
# Day 13: 1000 FREE conversations / month + Inline Keyboard Approve/Reject
# WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
# WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN

# --- Demo / Safety ---
# Day 12 Finance + Order are SIMULATED. Never use real money / real orders in demo.
DEMO_MODE=true
# If DEMO_MODE=true, Finance uses finance_expenses_sim, Order uses ecom_orders_sim
